# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_VERSION=v1

# ─── MongoDB Atlas ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/news-intelligence?retryWrites=true&w=majority
MONGODB_URI_TEST=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/news-intelligence-test?retryWrites=true&w=majority

# ─── JWT Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_change_in_prod
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_at_least_32_characters_long_change_in_prod
JWT_REFRESH_EXPIRE=30d
# Issuer/audience claims — must match what the server signs (algorithm pinning)
JWT_ISSUER=news-intelligence-api
JWT_AUDIENCE=news-intelligence-client

# ─── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2048
OPENAI_TEMPERATURE=0.7

# ─── Redis (for caching & queues) ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ─── NewsData.io (Primary news source) ────────────────────────────────────────
# Get your free API key at: https://newsdata.io/register

# AI & Integrations
OPENROUTER_API_KEY=your_openrouter_api_key_here
ENABLE_AI=true
NEWSDATA_API_KEY=your_newsdata_io_api_key_here
NEWSDATA_BASE_URL=https://newsdata.io/api/1
NEWSDATA_TIMEOUT_MS=15000
NEWSDATA_MAX_RETRIES=3
NEWSDATA_RETRY_DELAY_MS=1000
NEWSDATA_CONCURRENCY=3
NEWSDATA_TARGET_COUNT=200
NEWSDATA_BATCH_SIZE=10

# ─── Legacy NewsAPI.org (Optional / RSS fallback) ─────────────────────────────
NEWS_API_KEY=your_newsapi_org_key_here

# ─── Ingestion Scheduler ──────────────────────────────────────────────────────
NEWS_INGEST_CRON=*/30 * * * *
ENABLE_CRON=true

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FILE=logs/combined.log
LOG_ERROR_FILE=logs/error.log

# ─── Email (optional) ─────────────────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
FROM_EMAIL=noreply@newsintelligence.com
FROM_NAME=News Intelligence Platform

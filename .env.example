# ==========================================
# NEWS INTELLIGENCE PLATFORM - ENV CONFIG
# ==========================================

# 1. Backend Configuration
# ------------------------------------------
# Server Port
PORT=5000

# MongoDB Connection String
# Replace with your actual MongoDB URI (e.g., from MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/news-intelligence?retryWrites=true&w=majority

# Redis Connection (Required for caching & background jobs)
REDIS_URL=redis://127.0.0.1:6379

# Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_change_me_in_production
JWT_EXPIRES_IN=7d

# 2. AI & Data Pipeline Keys
# ------------------------------------------
# NewsData.io API Key - Used for fetching live articles
# Get one at: https://newsdata.io
NEWSDATA_API_KEY=your_newsdata_api_key_here

# OpenAI API Key - Used for AI summarization & sentiment analysis
OPENAI_API_KEY=sk-your_openai_api_key_here

# 3. Frontend Configuration
# ------------------------------------------
# The URL where the frontend can reach the backend API
NEXT_PUBLIC_API_URL=http://127.0.0.1:5000/api/v1
